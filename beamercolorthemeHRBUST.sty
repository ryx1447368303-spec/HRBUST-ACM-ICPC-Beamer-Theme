% HRBUST ACM-ICPC colors; no geometry or layout changes.
% Official blue: RGB(0,91,172), #005BAC.
\ProvidesPackage{beamercolorthemeHRBUST}[2026/10/13 HRBUST Beamer colors]
\mode<presentation>
\RequirePackage{xcolor}

\definecolor{hrbustblue}{HTML}{005BAC}
\definecolor{hrbustnavy}{HTML}{123352}
\definecolor{hrbustink}{HTML}{243448}
\definecolor{hrbustmuted}{HTML}{61768C}
\definecolor{hrbustteal}{HTML}{006D77}
\definecolor{hrbustamber}{HTML}{A35D08}
\definecolor{hrbustpale}{HTML}{EEF5FC}
% Upstream documents and TikZ illustrations can keep using this color name.
\colorlet{peaking}{hrbustblue}

\setbeamercolor{normal text}{fg=hrbustink,bg=white}
\setbeamercolor{structure}{fg=hrbustblue}
\setbeamercolor{alerted text}{fg=hrbustamber}
\setbeamercolor{example text}{fg=hrbustteal}

\setbeamercolor{footline}{bg=hrbustblue,fg=white}
\setbeamercolor{footline wing}{bg=hrbustnavy,fg=white}
\setbeamercolor{frametitle}{bg=hrbustblue,fg=white}
\setbeamercolor{title}{bg=hrbustblue,fg=white}
\setbeamercolor{subtitle}{fg=white}

\setbeamercolor{section in head/foot}{fg=white,bg=hrbustblue}
\setbeamercolor{section in head/foot shaded}{fg=hrbustblue!25!white}
\setbeamercolor{subsection in head/foot}{fg=white,bg=hrbustblue}
\setbeamercolor{subsection in head/foot shaded}{fg=hrbustblue!25!white}
\setbeamercolor{mini frame}{fg=white,bg=hrbustblue}
\setbeamercolor{author in head/foot}{fg=white}
\setbeamercolor{institute in head/foot}{fg=white}
\setbeamercolor{title in head/foot}{fg=white,bg=hrbustblue}
\setbeamercolor{date in head/foot}{fg=white}
\setbeamercolor{frame number}{fg=white}

\setbeamercolor{palette primary}{fg=white,bg=hrbustblue}
\setbeamercolor{palette secondary}{fg=white,bg=hrbustblue!80!hrbustnavy}
\setbeamercolor{palette tertiary}{fg=white,bg=hrbustnavy}
\setbeamercolor{palette quaternary}{fg=white,bg=hrbustnavy}
\setbeamercolor{titlelike}{parent=palette primary}

\setbeamercolor{block title}{fg=white,bg=hrbustblue}
\setbeamercolor{block body}{fg=hrbustink,bg=hrbustpale}
\setbeamercolor{block title alerted}{fg=white,bg=hrbustamber}
\setbeamercolor{block body alerted}{fg=hrbustink,bg=hrbustamber!7!white}
\setbeamercolor{block title example}{fg=white,bg=hrbustteal}
\setbeamercolor{block body example}{fg=hrbustink,bg=hrbustteal!6!white}

\setbeamercolor{fine separation line}{}
\setbeamercolor{separation line}{}
\setbeamercolor{item projected}{fg=white,bg=hrbustblue}
\setbeamercolor{caption name}{fg=hrbustblue}
\setbeamercolor{navigation symbols}{fg=hrbustblue!45!white}
\setbeamercolor{navigation symbols dimmed}{fg=hrbustblue!20!white}

\setbeamercolor{palette sidebar primary}{fg=hrbustink}
\setbeamercolor{palette sidebar secondary}{fg=hrbustblue}
\setbeamercolor{palette sidebar tertiary}{fg=hrbustink}
\setbeamercolor{palette sidebar quaternary}{fg=hrbustblue}
\setbeamercolor{section in sidebar}{fg=hrbustblue}
\setbeamercolor{section in sidebar shaded}{fg=hrbustmuted}
\setbeamercolor{subsection in sidebar}{fg=hrbustblue}
\setbeamercolor{subsection in sidebar shaded}{fg=hrbustmuted}
\setbeamercolor{sidebar}{parent=palette primary}
\mode<all>
\endinput
